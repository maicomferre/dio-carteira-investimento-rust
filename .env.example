# Copie para .env apenas no ambiente local. Nunca versione .env real.
APP_ENV=development
APP_BIND_ADDR=127.0.0.1:3000
APP_LOG_FORMAT=compact
RUST_LOG=carteira_de_investimentos_maicaosa=info,tower_http=info

DATABASE_URL=postgres://carteira_app:carteira_app_dev_password@127.0.0.1:5433/carteira_dev
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=3

# Desenvolvimento local: gere valores diferentes com `openssl rand -base64 48`.
# Produção deve usar secret manager/arquivo fora do Git.
AUTH_JWT_SECRET=dev-only-change-this-jwt-secret-with-at-least-32-chars
AUTH_SESSION_HASH_KEY=dev-only-change-this-session-hash-key-at-least-32
AUTH_JWT_ISSUER=carteira-de-investimentos-maicaosa
AUTH_JWT_AUDIENCE=carteira-web
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_MUTATION_RATE_LIMIT_MAX_REQUESTS=60
AUTH_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_MUTATION_RATE_LIMIT_BLOCK_SECONDS=300
AUTH_EXPIRED_SESSION_RETENTION_DAYS=7

# Busca de metadados de ativos pelo backend. O provider real ainda deve ser
# escolhido por licença/limites; o MVP usa provider local determinístico.
INSTRUMENT_PROVIDER_TIMEOUT_SECONDS=2
INSTRUMENT_PROVIDER_CACHE_TTL_SECONDS=3600
INSTRUMENT_PROVIDER_STALE_TTL_SECONDS=86400
INSTRUMENT_PROVIDER_MAX_RESULTS=8
