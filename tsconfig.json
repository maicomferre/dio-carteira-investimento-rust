{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "outDir": "static/dist",
    "rootDir": "frontend/src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["frontend/src/**/*.ts"]
}
